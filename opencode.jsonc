{
  "$schema": "https://opencode.ai/config.json",

  // ============================================================
  // CONFIG KHUSUS PROJECT MungkasDesk
  // File ini merge DI ATAS config global (~/.config/opencode/opencode.json),
  // jadi setting yang tidak ditulis di sini tetap diwarisi dari global.
  //
  // PENTING: blok "providers" SENGAJA tidak di-copy ke file ini.
  // Provider bansos-ai (beserta API key-nya) hidup di config global
  // yang tidak ke-push — repo ini public. Model "bansos-ai/*" tetap
  // bisa dipakai karena global config selalu ke-load dulu.
  // ============================================================

  "model": "bansos-ai/codingforFree",

  // ============================================================
  // INSTRUCTIONS — CONTEXT.md dimuat sebagai instruksi project untuk
  // SEMUA agent (bareng AGENTS.md yang sudah di-discovery otomatis).
  // CONTEXT.md = handover doc: status project, konvensi, backlog QA,
  // dan ATURAN WAJIB (mis. tiap akhir task agent wajib update
  // CONTEXT.md dan menyebutnya di laporan). Dengan begini aturan itu
  // terbaca tiap sesi tanpa perlu baca semua kode dulu.
  // ============================================================
  "instructions": ["CONTEXT.md"],

  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    }
  ],

  "experimental": {
    "todo": true
  },

  // ============================================================
  // MCP SERVERS
  // playwright = server resmi dari https://github.com/microsoft/playwright-mcp
  // Dipasang sesuai README-nya sebagai package npm @playwright/mcp via npx
  // (bukan clone repo — ini cara instal standarnya, jadi tidak ada folder
  // vendor di repo ini).
  //   --headless : browser tidak muncul di layar saat agent testing jalan
  //   --isolated : profil browser per sesi dibuang saat sesi ditutup, supaya
  //                tiap run testing mulai dari kondisi bersih (reproducible)
  // Hapus kedua flag itu di args kalau ingin melihat browser bergerak /
  // menyimpan state login antar sesi.
  // Dipakai utamanya oleh agent testing (.opencode/agents/testing.md) untuk
  // testing UI/E2E frontend (fase 1, Next.js) + pengambilan screenshot
  // untuk laporan HTML-nya.
  // ============================================================
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest", "--headless", "--isolated"]
      }
    }
  },

  // ============================================================
  // AGENTS
  // planner / executor / testing / versioning didefinisikan sebagai Markdown
  // agent di .opencode/agents/ (planner.md, executor.md, testing.md,
  // versioning.md) — masing-masing mode "all": bisa dipanggil sebagai
  // subagent atau dipilih langsung (Tab).
  //
  // versioning = pemegang sisi GitHub: commit, push (selalu minta approval),
  // tag/rilis SemVer, CHANGELOG, dan workflow GitHub Actions (folder .github/
  // belum ada — dibuat oleh agent ini saat diminta).
  // ============================================================
  "agents": {
  }
}
